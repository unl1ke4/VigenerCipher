  <ItemGroup>
    <ProjectReference Include="..\VigenereCipherLib\VigenereCipherLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Auth0.AspNetCore.Authentication" Version="1.5.0" />
  </ItemGroup>

</Project>
