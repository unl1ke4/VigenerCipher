@model List<VigenereCipherWeb.Data.CipherJob>
@{
    ViewData["Title"] = "Мої завдання шифрування";
}

<h1 class="display-4">📊 Історія моїх шифрувань</h1>
<p class="lead">Завдання поточного користувача (з JOIN до AppUsers та CipherMethods)</p>
<hr class="my-4" />

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info">
            <strong>Діагностика:</strong> @ViewBag.Message
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Search")" class="btn btn-success">🔍 Розширений пошук</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            <strong>Історія порожня.</strong> У вас ще немає завдань шифрування. Перейдіть на сторінку <a href="@Url.Action("Index", "Cipher")">Cipher</a>, щоб створити нове завдання.
        </div>
    }
else
{
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Input</th>
                <th>Key</th>
                <th>Operation</th>
                <th>Result</th>
                <th>Користувач</th>
                <th>Email</th>
                <th>Метод</th>
                <th>Дата</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model)
            {
                <tr>
                    <td>@job.Id</td>
                    <td>@job.InputText</td>
                    <td>@job.Key</td>
                    <td><span class="badge bg-info">@job.Operation</span></td>
                    <td>@job.ResultText</td>
                    <td>@(job.AppUser?.Username ?? "N/A")</td>
                    <td><small>@(job.AppUser?.Email ?? "N/A")</small></td>
                    <td>@job.CipherMethod.Name</td>
                    <td>@job.CreatedAt.ToString("dd.MM.yy HH:mm")</td>
                    <td>
                        <a href="@Url.Action("Details", new { id = job.Id })" class="btn btn-sm btn-primary">Деталі</a>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">← Назад на головну</a>
</div>
