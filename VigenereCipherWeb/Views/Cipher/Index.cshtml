@model VigenereCipherWeb.Models.VigenereViewModel 
@{
    ViewData["Title"] = "Шифратор Віженера";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<h2>@ViewData["Title"]</h2>
<p>Використовуйте форму нижче для шифрування або дешифрування тексту.</p>
<hr />

<div class="row">
    <div class="col-md-6">
        
        <form asp-action="Index" method="post">
            
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="form-group mb-3">
                <label asp-for="InputText" class="control-label"></label>
                <textarea asp-for="InputText" class="form-control" rows="5"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Key" class="control-label"></label>
                <input asp-for="Key" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Дія:</label>
                <select asp-for="Operation" class="form-select">
                    <option value="encrypt">Шифрувати</option>
                    <option value="decrypt">Дешифрувати</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-primary">Виконати</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ResultText))
    {
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="ResultText" class="control-label"></label>
                <textarea asp-for="ResultText" class="form-control" rows="10" readonly>@Model.ResultText</textarea>
            </div>
        </div>
    }
</div>